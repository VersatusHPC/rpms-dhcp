diff -up dhcp-4.3.3/client/dhclient.c.duid_uuid dhcp-4.3.3/client/dhclient.c
--- dhcp-4.3.3/client/dhclient.c.duid_uuid	2015-12-14 12:10:54.694082625 +0100
+++ dhcp-4.3.3/client/dhclient.c	2015-12-14 12:13:19.538018362 +0100
@@ -3328,6 +3328,59 @@ write_options(struct client_state *clien
 	}
 }
 
+int unhexchar(char c) {
+
+	if (c >= '0' && c <= '9')
+		return c - '0';
+
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+
+	return -1;
+}
+
+isc_result_t
+read_uuid(u_int8_t* uuid) {
+	const char *id_fname = "/etc/machine-id";
+	char id[32];
+	size_t nread;
+	FILE * file = fopen( id_fname , "r");
+	if (!file) {
+		log_debug("Cannot open %s", id_fname);
+		return ISC_R_IOERROR;
+	}
+	nread = fread(id, 1, sizeof id, file);
+	fclose(file);
+
+	if (nread < 32) {
+		log_debug("Not enough data in %s", id_fname);
+		return ISC_R_IOERROR;
+	}
+
+	for (int j = 0; j < 16; j++) {
+		int a, b;
+
+		a = unhexchar(id[j*2]);
+		b = unhexchar(id[j*2+1]);
+
+		if (a < 0 || b < 0) {
+			log_debug("Wrong data in %s", id_fname);
+                        return ISC_R_IOERROR;
+		}
+		uuid[j] = a << 4 | b;
+	}
+
+	/* Set UUID version to 4 --- truly random generation */
+	uuid[6] = (uuid[6] & 0x0F) | 0x40;
+	/* Set the UUID variant to DCE */
+	uuid[8] = (uuid[8] & 0x3F) | 0x80;
+
+	return ISC_R_SUCCESS;
+}
+
